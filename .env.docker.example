# F6 (T5.1) — modelo do .env da pilha Docker. Copie para `.env` na raiz e preencha.
#
# Este arquivo é exemplo de formato, não configuração: nenhuma linha dele faz a pilha subir.
# O `docker compose config` recusa com o nome da variável sempre que uma obrigatorícia está
# ausente, e a régua A9 (apps/api/src/config/producao.ts) recusa de novo quando o processo
# nasce, antes da primeira requisição. O `.env` preenchido fica na máquina e nunca vai para o
# git — `.env` está no .gitignore da raiz.
#
# Regra da casa, aqui também: segredo não se imprime. Nenhum comando desta documentação ecoa
# valor de senha, token ou chave.

# ------------------------------------------------------------------ banco (serviço mysql)
# Nome do banco da instalação. O sufixo `_teste` é reservado ao banco de prova da suíte
# (decisão D6) e não pertence a esta pilha.
MYSQL_DATABASE=
# A conta da aplicação. Nunca root: a produção recusa root sem senha, e root com senha é o
# privilégio que não se justifica para um serviço que só escreve no próprio banco.
MYSQL_USER=nexus_app
# Senhas alfanuméricas (sem @, : nem /): a string de conexão do Prisma é montada no compose,
# e caractere reservado de URL precisa de escape para funcionar.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# ------------------------------------------------------------------ api
# Endereço do painel, sem `localhost` e sem `*`. Em produção a API não sobe com CORS de
# máquina local, porque isso significa "qualquer aba desta máquina pode chamar".
CORS_ORIGIN=https://painel.seudominio.com.br
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Gere cada um com: node -e "process.stdout.write(require('node:crypto').randomBytes(32).toString('hex'))"
# (o valor vai no arquivo, nunca no console de quem revisa a instalação).
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Janela de requisições por endereço. O compose tem default e a régua de produção não cobra,
# mas uma instalação atrás de proxy sem TRUST_PROXY declarado mede a janela no proxy, não no cliente.
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# O administrador global da plataforma (regra definitiva de acesso). Em produção o endereço
# vem do ambiente — o código não carrega e-mail nenhum.
SUPER_ADMIN_EMAIL=

# 64 caracteres hexadecimal (32 bytes), a chave que cifra o segredo de segundo fator em
# repouso. Sem ela a produção não sobe: 2FA com segredo em claro não é 2FA.
TOTP_ENCRYPTION_KEY=

# Verificação de cadastro ligada (D2). Em produção a régua exige o "1": conta nova só entra
# no painel com o e-mail confirmado.
REQUIRE_EMAIL_VERIFICATION=1

# Saída de mensagem (D1): produção exige SMTP de verdade, com host, porta e remetente.
# Console e caixa de teste não entregam ninguém, e "recupere sua senha" sem caixa de saída é
# conta trancada por fora.
MAIL_TRANSPORT=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
MAIL_FROM=
# O link que sai no corpo do e-mail. https obrigatório em produção.
WEB_BASE_URL=https://painel.seudominio.com.br

# ------------------------------------------------------------------ pilha
# Porta publicada no host para o painel. É a ÚNICA porta desta topologia: o banco não publica
# nada e a API também não. 8080 porque o 80 da máquina costuma ter dono (no WAMP, o Apache).
PAINEL_PORT=8080
# Ambiente do processo da API. O padrão é produção, e é produção que a régua A9 cobra.
NEXUS_NODE_ENV=production
CRON_ENABLED=1
BODY_LIMIT_BYTES=1048576
