# Ambiente
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Frontend permitido (CORS) — lista separada por vírgula
CORS_ORIGIN=http://localhost:5173

# Banco MySQL local (WAMP). NÃO commitar credenciais reais.
DATABASE_URL="mysql://root@localhost:3306/nexusbusinessmanager"

# JWT — gere segredos fortes e distintos por ambiente. Não usar em produção.
JWT_ACCESS_SECRET=troque-por-um-segredo-forte-de-32-mais-bytes
JWT_REFRESH_SECRET=troque-por-outro-segredo-forte-de-32-mais-bytes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Rate limit
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Senha do administrador global, usada pelo prisma/seed.ts. O valor real fica
# apenas no CREDENCIAIS.md da maquina; aqui vai so o lembrete do formato.
SEED_ADMIN_PASSWORD=troque-pela-senha-do-administrador-definitivo

# Fase 2 da auditoria (seguranca de producao):
# AUTH_EXPOSE_RESET_TOKEN=1 devolve o codigo de recuperacao na resposta do
# forgot-password, sem SMTP. So em desenvolvimento declarado — nunca em producao.
AUTH_EXPOSE_RESET_TOKEN=0
# TRUST_PROXY=1 habilita X-Forwarded-* (rate-limit e auditoria veem o IP real
# atras de um proxy). Ligue apenas quando a API estiver detras de proxy seu.
TRUST_PROXY=0
# Tamanho maximo do corpo de uma requisicao (bytes). 1 MiB default.
BODY_LIMIT_BYTES=1048576
# CRON_ENABLED=1 liga o agendador das rotinas /ops/jobs no processo da API.
CRON_ENABLED=0
# SEED_DEV_ACCOUNT=1 forca a conta dev admin@nexus.local mesmo em producao
# (caso raro: ambiente de teste). Fora de producao a conta dev e criada sempre.
SEED_DEV_ACCOUNT=0
