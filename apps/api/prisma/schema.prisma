// Nexus Business Manager — schema novo (reconstrução do zero).
// Persistência única via Prisma (ADR-0001). MySQL localhost:3306 / nexusbusinessmanager.
// IDs são UUID (36 chars): tipados como VarChar(36) para manter índices compostos
// dentro do limite de chave do InnoDB com utf8mb4.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  STAFF
}

// Papel de PLATAFORMA, separado do papel dentro da empresa (enum Role).
// Só existe o administrador da plataforma: ele responde pela vitrine (CMS),
// pelas rotinas agendadas e entra em toda empresa como OWNER (Fase 1b).
enum PlatformRole {
  SUPER_ADMIN
}

model User {
  id                    String                @id @default(uuid()) @db.VarChar(36)
  email                 String                @unique
  name                  String
  phone                 String?               @db.VarChar(32)
  avatarUrl             String?               @map("avatar_url") @db.VarChar(255)
  passwordHash          String                @map("password_hash")
  active                Boolean               @default(true)
  platformRole          PlatformRole?         @map("platform_role")
  // N32 (decisão D5): a última empresa que a pessoa escolheu em `switch-company`.
  // Sem ela, o login sem empresa pedida não tinha resposta determinística: a
  // escolha caía na primeira empresa ativa na ordem que o índice do banco
  // entrega, e quem tem mais de uma casa acordava numa diferente a cada login.
  // Nullable e sem chave estrangeira de propósito: é preferência, não vínculo.
  // A casa pode ser excluída ou adormecer, e a conta continua entrando — a
  // camada de auth confere o vínculo ativo antes de usar a lembrança.
  lastCompanyId         String?               @map("last_company_id") @db.VarChar(36)
  // F4 (decisão D2 do dono): verificação de e-mail. Nulo = a caixa postal nunca
  // foi confirmada. O login só bloqueia por isto quando o ambiente declara
  // REQUIRE_EMAIL_VERIFICATION=1, que é a régua de produção — contas antigas do
  // desenvolvimento e do banco de prova continuam entrando sem ler caixa nenhuma,
  // e uma conta criada por quem administra a instalação (o bootstrap) nasce
  // confirmada de propósito: não existe e-mail de verdade atrás dela.
  emailVerifiedAt       DateTime?             @map("email_verified_at")
  // F4 (decisão D3): segredo do segundo fator. NUNCA em claro — o texto guardado
  // aqui é o envelope `v1:<iv>:<tag>:<texto cifrado>` produzido por
  // `lib/criptografia.ts` com AES-256-GCM e a chave `TOTP_ENCRYPTION_KEY`. Ler o
  // banco inteiro, portanto, não dá a ninguém a capacidade de gerar códigos
  // válidos: falta a chave, que vive só no ambiente de quem hospeda.
  totpSecretCiphertext  String?               @map("totp_secret_ciphertext") @db.VarChar(512)
  // Ligado de fato: só depois de conferir um código gerado com o segredo pendente.
  // Segredo gerado e nunca confirmado fica com esta coluna nula e não protege
  // login nenhum.
  totpEnabledAt         DateTime?             @map("totp_enabled_at")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")
  memberships           CompanyUser[]
  sessions              RefreshToken[]
  auditLogs             AuditLog[]
  resetTokens           PasswordResetToken[]
  sales                 Sale[]
  purchases             Purchase[]
  financeEntries        FinanceEntry[]
  leads                 Lead[]
  agendaEvents          AgendaEvent[]
  // Ordens de serviço (F3.2 Parte 1): três relações com User porque são três
  // perguntas diferentes — quem atende, quem abriu o chamado e quem mudou o
  // status. Uma só relação não responderia nenhuma delas com clareza.
  serviceOrdersAssigned ServiceOrder[]        @relation("ServiceOrderAssigned")
  serviceOrdersCreated  ServiceOrder[]        @relation("ServiceOrderCreated")
  serviceOrderHistory   ServiceOrderHistory[] @relation("ServiceOrderHistory")
  // Cobranças (F3.2 Parte 2): as mesmas três perguntas da OS — quem abriu a
  // cobrança, quem registrou o recebimento e quem cancelou.
  chargesCreated        Charge[]              @relation("ChargeCreated")
  chargesPaid           Charge[]              @relation("ChargePaid")
  chargesCancelled      Charge[]              @relation("ChargeCancelled")

  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  // F4: os códigos de um lado (verificação de e-mail, segundo fator) vivem em
  // tabelas próprias e caem junto da conta — são chave de acesso dela, e uma
  // chave órfã de quem saiu do sistema não tem dono nem utilidade.
  verificationTokens      EmailVerificationToken[]
  recoveryCodes           RecoveryCode[]
  // F7 (LGPD): os aceites dos textos legais, na mesma lógica das chaves de acesso —
  // caem junto da conta, porque um registro de quem não existe mais no sistema não
  // tem a quem apontar.
  consentRecords          ConsentRecord[]

  @@map("users")
}

model Company {
  id                   String            @id @default(uuid()) @db.VarChar(36)
  name                 String
  slug                 String            @unique
  active               Boolean           @default(true)
  legalName            String?           @map("legal_name") @db.VarChar(160)
  tradeName            String?           @map("trade_name") @db.VarChar(160)
  cnpj                 String?           @db.VarChar(18)
  phone                String?           @db.VarChar(32)
  email                String?           @db.VarChar(160)
  zipCode              String?           @map("zip_code") @db.VarChar(16)
  street               String?           @db.VarChar(160)
  number               String?           @db.VarChar(32)
  district             String?           @db.VarChar(80)
  city                 String?           @db.VarChar(80)
  stateUf              String?           @map("state_uf") @db.VarChar(2)
  logoUrl              String?           @map("logo_url") @db.VarChar(255)
  currency             String            @default("BRL") @db.VarChar(8)
  timezone             String            @default("America/Sao_Paulo") @db.VarChar(64)
  language             String            @default("pt-BR") @db.VarChar(8)
  revenueTarget        Decimal?          @map("revenue_target") @db.Decimal(14, 2)
  // Fase 3b da auditoria: política de estoque é decisão da empresa, não do
  // sistema. Falso (padrão) = nenhuma saída empurra o saldo para negativo;
  // verdadeiro = a baixa acontece mesmo sem saldo e o negativo fica visível
  // como dívida de estoque a acertar.
  allowNegativeStock   Boolean           @default(false) @map("allow_negative_stock")
  // Fase 3e da auditoria: venda confirmada e compra recebida existiam sem
  // reflexo nenhum no financeiro — o relatório mostrava a receita e o caixa
  // nunca tinha visto aquele dinheiro. O vínculo passa a ser gerado pelo
  // sistema, mas desligado por padrão nas duas pontas: uma empresa que já lança
  // a receita à mão receberia o dobro dela no dia em que ligasse a opção sem
  // querer. São duas chaves e não uma só porque venda e compra são decisões de
  // hábito diferentes: há quem confira o dinheiro que entra e lance o que sai
  // à mão, e o contrário também existe.
  autoFinanceSales     Boolean           @default(false) @map("auto_finance_sales")
  autoFinancePurchases Boolean           @default(false) @map("auto_finance_purchases")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")
  members              CompanyUser[]
  auditLogs            AuditLog[]
  clients              Client[]
  categories           ProductCategory[]
  products             Product[]
  stockMovements       StockMovement[]
  sales                Sale[]
  suppliers            Supplier[]
  purchases            Purchase[]
  financeCategories    FinanceCategory[]
  financeEntries       FinanceEntry[]
  leads                Lead[]
  agendaEvents         AgendaEvent[]

  notificationPreferences NotificationPreference[]
  notifications           Notification[]
  paymentGateways         PaymentGateway[]
  serviceOrders           ServiceOrder[]
  charges                 Charge[]

  @@map("companies")
}

// Vínculo usuário↔empresa com papel (isolamento multiempresa, ADR-0002).
model CompanyUser {
  id        String   @id @default(uuid()) @db.VarChar(36)
  userId    String   @map("user_id") @db.VarChar(36)
  companyId String   @map("company_id") @db.VarChar(36)
  role      Role     @default(STAFF)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
  @@map("company_users")
}

// Sessões para controle/revogação de tokens de refresh.
model RefreshToken {
  id          String    @id @default(uuid()) @db.VarChar(36)
  userId      String    @map("user_id") @db.VarChar(36)
  // A4 do prompt de mercado: a empresa ativa da sessão mora no refresh token,
  // não só no access token (que vence em minutos). Sem esta coluna, toda
  // renovação caía na primeira empresa ativa do usuário — quem trocava para a B
  // acordava na A depois do primeiro refresh silencioso. Nullable de propósito:
  // os tokens emitidos antes da migration continuam válidos, com o
  // comportamento antigo. É coluna simples, sem chave estrangeira, porque o
  // ciclo de vida da sessão é curto e não pode travar a exclusão de uma empresa.
  companyId   String?   @map("company_id") @db.VarChar(36)
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  // Fase 2 da auditoria: `usedAt` marca o token como consumido pela rotação.
  // Ele distingue o reuso malicioso de um token já rotacionado (a família
  // inteira é derrubada) de uma revogação manual normal (logout, admin,
  // recuperação de senha), que só grava `revokedAt`.
  usedAt      DateTime? @map("used_at")
  createdByIp String?   @map("created_by_ip")
  createdAt   DateTime  @default(now()) @map("created_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  // A6: a aba Sessões pergunta "o que está aberto nesta empresa?". Sem índice,
  // cada listagem varre a tabela inteira de tokens.
  @@index([companyId])
  @@map("refresh_tokens")
}

// Auditoria (seção 36): ator, ação, entidade, contexto empresarial.
model AuditLog {
  id        String   @id @default(uuid()) @db.VarChar(36)
  userId    String?  @map("user_id") @db.VarChar(36)
  companyId String?  @map("company_id") @db.VarChar(36)
  // F2 (N14): "tenant" (padrao) ou "platform". A coluna decide em qual
  // trilha o evento aparece; evento de plataforma nunca tem empresa dona.
  scope     String   @default("tenant") @db.VarChar(16)
  action    String
  entity    String
  entityId  String?  @map("entity_id") @db.VarChar(36)
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([scope, createdAt])
  @@index([userId])
  @@map("audit_logs")
}

// ===== Modulos empresariais (todos com isolamento por empresa, ADR-0002) =====

enum SaleStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum PurchaseStatus {
  DRAFT
  RECEIVED
  CANCELLED
}

enum StockMovementKind {
  IN
  OUT
  ADJUST
}

enum EntryType {
  INCOME
  EXPENSE
}

enum EntryStatus {
  PENDING
  PAID
  CANCELLED
}

enum LeadStatus {
  NEW
  CONTACTED
  PROPOSAL
  WON
  LOST
}

model Client {
  id             String         @id @default(uuid()) @db.VarChar(36)
  companyId      String         @map("company_id") @db.VarChar(36)
  name           String         @db.VarChar(160)
  email          String?        @db.VarChar(160)
  phone          String?        @db.VarChar(32)
  document       String?        @db.VarChar(32)
  notes          String?        @db.Text
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sales          Sale[]
  financeEntries FinanceEntry[]
  leads          Lead[]
  agendaEvents   AgendaEvent[]
  serviceOrders  ServiceOrder[]
  charges        Charge[]

  @@unique([companyId, document])
  @@index([companyId, name])
  @@map("clients")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.VarChar(36)
  userId    String    @map("user_id") @db.VarChar(36)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// F4 (decisão D2): o mesmo desenho do token de recuperação, para outra
// pergunta — "este e-mail existe de fato?". Guarda só o HMAC, nunca o código,
// por nada: uma tabela dessas lida junto do dump do banco daria a qualquer um o
// direito de confirmar a caixa postal de outra pessoa.
model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.VarChar(36)
  userId    String    @map("user_id") @db.VarChar(36)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

// F4 (decisão D3): códigos de recuperação do segundo fator, um por linha, cada
// um usável uma única vez. Hash (o mesmo HMAC dos tokens de sessão) e não
// segredo em claro: quem lê o banco não ganha uma porta de entrada, e quem
// perdeu o telefone continua tendo como entrar.
model RecoveryCode {
  id        String    @id @default(uuid()) @db.VarChar(36)
  userId    String    @map("user_id") @db.VarChar(36)
  codeHash  String    @unique @map("code_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("recovery_codes")
}

// F4: tentativa de login por endereço de e-mail. A chave é o endereço, e não o
// id da conta, de propósito: um atacante que testa endereços que não existem
// ainda não sabe que não sabe — sem esta linha o bloqueio existiria só para
// quem acertou um e-mail cadastrado, e a própria diferença de resposta entregaria
// a informação. A tabela é de contagem, não de usuário: nada aponta para `users`.
model LoginAttempt {
  email         String    @id @db.VarChar(191)
  failures      Int       @default(0)
  firstFailedAt DateTime  @map("first_failed_at")
  lastFailedAt  DateTime  @map("last_failed_at")
  lockedUntil   DateTime? @map("locked_until")

  @@map("login_attempts")
}

model ProductCategory {
  id        String    @id @default(uuid()) @db.VarChar(36)
  companyId String    @map("company_id") @db.VarChar(36)
  name      String    @db.VarChar(80)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products  Product[]

  @@unique([companyId, name])
  @@map("product_categories")
}

model Product {
  id                String             @id @default(uuid()) @db.VarChar(36)
  companyId         String             @map("company_id") @db.VarChar(36)
  categoryId        String?            @map("category_id") @db.VarChar(36)
  name              String             @db.VarChar(160)
  sku               String?            @db.VarChar(64)
  unit              String             @default("un") @db.VarChar(16)
  costPrice         Decimal?           @map("cost_price") @db.Decimal(12, 2)
  salePrice         Decimal            @map("sale_price") @db.Decimal(12, 2)
  stockQuantity     Decimal            @default(0) @map("stock_quantity") @db.Decimal(12, 3)
  minStock          Decimal            @default(0) @map("min_stock") @db.Decimal(12, 3)
  trackStock        Boolean            @default(true) @map("track_stock")
  description       String?            @db.Text
  active            Boolean            @default(true)
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category          ProductCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  movements         StockMovement[]
  saleItems         SaleItem[]
  purchaseItems     PurchaseItem[]
  serviceOrderItems ServiceOrderItem[]

  @@unique([companyId, sku])
  @@index([companyId, name])
  @@map("products")
}

// Movimentacao de estoque (entradas/saidas/ajustes). Vendas do modulo
// posterior registrarao saidas com reference cruzada em metadata.
model StockMovement {
  id        String            @id @default(uuid()) @db.VarChar(36)
  companyId String            @map("company_id") @db.VarChar(36)
  productId String            @map("product_id") @db.VarChar(36)
  kind      StockMovementKind
  quantity  Decimal           @db.Decimal(12, 3)
  note      String?           @db.VarChar(255)
  createdBy String?           @map("created_by") @db.VarChar(36)
  createdAt DateTime          @default(now()) @map("created_at")
  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product   Product           @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([companyId, productId, createdAt])
  @@map("stock_movements")
}

// ===== Vendas (modulo 8) =====
model Sale {
  id             String         @id @default(uuid()) @db.VarChar(36)
  companyId      String         @map("company_id") @db.VarChar(36)
  clientId       String?        @map("client_id") @db.VarChar(36)
  userId         String?        @map("user_id") @db.VarChar(36)
  status         SaleStatus     @default(PENDING)
  total          Decimal        @db.Decimal(14, 2)
  // Fase 3e: em quantas parcelas mensais o total se divide. 1 (padrão) é "à
  // vista" — uma única parcela com o valor cheio, que é exatamente o que o
  // financeiro mostrava quando o lançamento era feito à mão.
  installments   Int            @default(1)
  notes          String?        @db.VarChar(500)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client         Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  user           User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  items          SaleItem[]
  // Procedência dos lançamentos gerados (lib/installments.ts). SetNull e não
  // Cascade: lançamento é escrituração — a venda pode sair do sistema, o
  // lançamento que já foi pago não sai junto com ela.
  financeEntries FinanceEntry[]
  charges        Charge[]

  @@index([companyId, status, createdAt])
  @@map("sales")
}

model SaleItem {
  id        String  @id @default(uuid()) @db.VarChar(36)
  saleId    String  @map("sale_id") @db.VarChar(36)
  productId String  @map("product_id") @db.VarChar(36)
  quantity  Decimal @db.Decimal(12, 3)
  unitPrice Decimal @map("unit_price") @db.Decimal(12, 2)
  lineTotal Decimal @map("line_total") @db.Decimal(14, 2)
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@map("sale_items")
}

model Supplier {
  id             String         @id @default(uuid()) @db.VarChar(36)
  companyId      String         @map("company_id") @db.VarChar(36)
  name           String         @db.VarChar(160)
  email          String?        @db.VarChar(160)
  phone          String?        @db.VarChar(40)
  document       String?        @db.VarChar(25)
  notes          String?        @db.VarChar(500)
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchases      Purchase[]
  financeEntries FinanceEntry[]

  @@unique([companyId, name])
  @@index([companyId, active])
  @@map("suppliers")
}

model Purchase {
  id             String         @id @default(uuid()) @db.VarChar(36)
  companyId      String         @map("company_id") @db.VarChar(36)
  supplierId     String         @map("supplier_id") @db.VarChar(36)
  userId         String?        @map("user_id") @db.VarChar(36)
  status         PurchaseStatus @default(DRAFT)
  total          Decimal        @db.Decimal(14, 2)
  // Mesma régua da venda (Fase 3e): quantas parcelas mensais o fornecedor vai
  // receber. 1 é à vista.
  installments   Int            @default(1)
  notes          String?        @db.VarChar(500)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier       Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  user           User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  items          PurchaseItem[]
  financeEntries FinanceEntry[]

  @@index([companyId, status, createdAt])
  @@map("purchases")
}

model PurchaseItem {
  id         String   @id @default(uuid()) @db.VarChar(36)
  purchaseId String   @map("purchase_id") @db.VarChar(36)
  productId  String   @map("product_id") @db.VarChar(36)
  quantity   Decimal  @db.Decimal(12, 3)
  unitCost   Decimal  @map("unit_cost") @db.Decimal(12, 2)
  lineTotal  Decimal  @map("line_total") @db.Decimal(14, 2)
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([purchaseId])
  @@map("purchase_items")
}

model FinanceCategory {
  id        String         @id @default(uuid()) @db.VarChar(36)
  companyId String         @map("company_id") @db.VarChar(36)
  name      String         @db.VarChar(80)
  type      EntryType
  createdAt DateTime       @default(now()) @map("created_at")
  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  entries   FinanceEntry[]

  @@unique([companyId, name, type])
  @@map("finance_categories")
}

model FinanceEntry {
  id          String           @id @default(uuid()) @db.VarChar(36)
  companyId   String           @map("company_id") @db.VarChar(36)
  categoryId  String?          @map("category_id") @db.VarChar(36)
  clientId    String?          @map("client_id") @db.VarChar(36)
  supplierId  String?          @map("supplier_id") @db.VarChar(36)
  userId      String?          @map("user_id") @db.VarChar(36)
  type        EntryType
  status      EntryStatus      @default(PENDING)
  description String           @db.VarChar(200)
  amount      Decimal          @db.Decimal(14, 2)
  dueDate     DateTime         @map("due_date") @db.Date
  paidAt      DateTime?        @map("paid_at")
  notes       String?          @db.VarChar(500)
  // Fase 3e: de qual venda ou compra este lançamento nasceu. Os dois são
  // opcionais e se excluem na camada de serviço (um lançamento gerado vem de um
  // documento só); manual tem os dois nulos. `saleId`/`purchaseId` ficam quando
  // o documento é apagado — SetNull, porque despesa e receita escrituradas não
  // somem junto do pedido, e porque o teste de limpeza já apaga
  // `finance_entries` antes de `sales`/`purchases`.
  saleId      String?          @map("sale_id") @db.VarChar(36)
  purchaseId  String?          @map("purchase_id") @db.VarChar(36)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category    FinanceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  client      Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  supplier    Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  user        User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  sale        Sale?            @relation(fields: [saleId], references: [id], onDelete: SetNull)
  purchase    Purchase?        @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  // F3.2 Parte 2: o lançamento que uma cobrança gerou. O lado dono do vínculo é
  // `Charge.financeEntryId` (UNIQUE lá), então aqui é só a leitura de volta.
  charge      Charge?

  @@index([companyId, status, dueDate])
  @@index([saleId])
  @@index([purchaseId])
  @@map("finance_entries")
}

model Lead {
  id        String     @id @default(uuid()) @db.VarChar(36)
  companyId String     @map("company_id") @db.VarChar(36)
  clientId  String?    @map("client_id") @db.VarChar(36)
  userId    String?    @map("user_id") @db.VarChar(36)
  name      String     @db.VarChar(160)
  email     String?    @db.VarChar(160)
  phone     String?    @db.VarChar(40)
  source    String?    @db.VarChar(60)
  status    LeadStatus @default(NEW)
  value     Decimal    @default(0) @db.Decimal(14, 2)
  notes     String?    @db.VarChar(1000)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client    Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  agendaEvents AgendaEvent[]

  @@index([companyId, status, createdAt])
  @@map("leads")
}

// Modulo Agenda: compromissos da empresa, com vinculo opcional a cliente e lead.
enum AgendaEventType {
  MEETING
  DELIVERY
  FOLLOW_UP
  OTHER
}

enum AgendaRecurrence {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

enum AgendaStatus {
  SCHEDULED
  DONE
  CANCELLED
}

model AgendaEvent {
  id             String           @id @default(uuid()) @db.VarChar(36)
  companyId      String           @map("company_id") @db.VarChar(36)
  userId         String?          @map("user_id") @db.VarChar(36)
  clientId       String?          @map("client_id") @db.VarChar(36)
  leadId         String?          @map("lead_id") @db.VarChar(36)
