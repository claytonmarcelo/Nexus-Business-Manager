// Nexus Business Manager — schema novo (reconstrução do zero).
// Persistência única via Prisma (ADR-0001). MySQL localhost:3306 / nexusbusinessmanager.
// IDs são UUID (36 chars): tipados como VarChar(36) para manter índices compostos
// dentro do limite de chave do InnoDB com utf8mb4.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  STAFF
}

model User {
  id           String         @id @default(uuid()) @db.VarChar(36)
  email        String         @unique
  name         String
  passwordHash String         @map("password_hash")
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  memberships     CompanyUser[]
  sessions        RefreshToken[]
  auditLogs       AuditLog[]
  resetTokens     PasswordResetToken[]

  @@map("users")
}

model Company {
  id        String        @id @default(uuid()) @db.VarChar(36)
  name      String
  slug      String        @unique
  active    Boolean       @default(true)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  members     CompanyUser[]
  auditLogs   AuditLog[]
  clients       Client[]
  categories    ProductCategory[]
  products      Product[]
  stockMovements StockMovement[]

  @@map("companies")
}

// Vínculo usuário↔empresa com papel (isolamento multiempresa, ADR-0002).
model CompanyUser {
  id        String   @id @default(uuid()) @db.VarChar(36)
  userId    String   @map("user_id") @db.VarChar(36)
  companyId String   @map("company_id") @db.VarChar(36)
  role      Role     @default(STAFF)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
  @@map("company_users")
}

// Sessões para controle/revogação de tokens de refresh.
model RefreshToken {
  id          String    @id @default(uuid()) @db.VarChar(36)
  userId      String    @map("user_id") @db.VarChar(36)
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdByIp String?   @map("created_by_ip")
  createdAt   DateTime  @default(now()) @map("created_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// Auditoria (seção 36): ator, ação, entidade, contexto empresarial.
model AuditLog {
  id        String   @id @default(uuid()) @db.VarChar(36)
  userId    String?  @map("user_id") @db.VarChar(36)
  companyId String?  @map("company_id") @db.VarChar(36)
  action    String
  entity    String
  entityId  String?  @map("entity_id") @db.VarChar(36)
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([userId])
  @@map("audit_logs")
}

// ===== Modulos empresariais (todos com isolamento por empresa, ADR-0002) =====

enum SaleStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum PurchaseStatus {
  DRAFT
  RECEIVED
  CANCELLED
}

enum StockMovementKind {
  IN
  OUT
  ADJUST
}

enum EntryType {
  INCOME
  EXPENSE
}

enum EntryStatus {
  PENDING
  PAID
  CANCELLED
}

enum LeadStatus {
  NEW
  CONTACTED
  PROPOSAL
  WON
  LOST
}

model Client {
  id        String   @id @default(uuid()) @db.VarChar(36)
  companyId String   @map("company_id") @db.VarChar(36)
  name      String   @db.VarChar(160)
  email     String?  @db.VarChar(160)
  phone     String?  @db.VarChar(32)
  document  String?  @db.VarChar(32)
  notes     String?  @db.Text
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, document])
  @@index([companyId, name])
  @@map("clients")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.VarChar(36)
  userId    String    @map("user_id") @db.VarChar(36)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model ProductCategory {
  id        String    @id @default(uuid()) @db.VarChar(36)
  companyId String    @map("company_id") @db.VarChar(36)
  name      String    @db.VarChar(80)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products  Product[]

  @@unique([companyId, name])
  @@map("product_categories")
}

model Product {
  id            String           @id @default(uuid()) @db.VarChar(36)
  companyId     String           @map("company_id") @db.VarChar(36)
  categoryId    String?          @map("category_id") @db.VarChar(36)
  name          String           @db.VarChar(160)
  sku           String?          @db.VarChar(64)
  unit          String           @default("un") @db.VarChar(16)
  costPrice     Decimal?         @map("cost_price") @db.Decimal(12, 2)
  salePrice     Decimal          @map("sale_price") @db.Decimal(12, 2)
  stockQuantity Decimal          @default(0) @map("stock_quantity") @db.Decimal(12, 3)
  minStock      Decimal          @default(0) @map("min_stock") @db.Decimal(12, 3)
  trackStock    Boolean          @default(true) @map("track_stock")
  description   String?          @db.Text
  active        Boolean          @default(true)
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  company       Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category      ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  movements     StockMovement[]

  @@unique([companyId, sku])
  @@index([companyId, name])
  @@map("products")
}

// Movimentacao de estoque (entradas/saidas/ajustes). Vendas do modulo
// posterior registrarao saidas com reference cruzada em metadata.
model StockMovement {
  id        String            @id @default(uuid()) @db.VarChar(36)
  companyId String            @map("company_id") @db.VarChar(36)
  productId String            @map("product_id") @db.VarChar(36)
  kind      StockMovementKind
  quantity  Decimal           @db.Decimal(12, 3)
  note      String?           @db.VarChar(255)
  createdBy String?           @map("created_by") @db.VarChar(36)
  createdAt DateTime          @default(now()) @map("created_at")
  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product   Product           @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([companyId, productId, createdAt])
  @@map("stock_movements")
}
