// Nexus Business Manager — schema novo (reconstrução do zero).
// Persistência única via Prisma (ADR-0001). MySQL localhost:3306 / nexusbusinessmanager.
// IDs são UUID (36 chars): tipados como VarChar(36) para manter índices compostos
// dentro do limite de chave do InnoDB com utf8mb4.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  STAFF
}

model User {
  id             String               @id @default(uuid()) @db.VarChar(36)
  email          String               @unique
  name           String
  phone          String?              @db.VarChar(32)
  avatarUrl      String?              @map("avatar_url") @db.VarChar(255)
  passwordHash   String               @map("password_hash")
  active         Boolean              @default(true)
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  memberships    CompanyUser[]
  sessions       RefreshToken[]
  auditLogs      AuditLog[]
  resetTokens    PasswordResetToken[]
  sales          Sale[]
  purchases      Purchase[]
  financeEntries FinanceEntry[]
  leads          Lead[]
  agendaEvents   AgendaEvent[]

  notifications           Notification[]
  notificationPreferences NotificationPreference[]

  @@map("users")
}

model Company {
  id                String            @id @default(uuid()) @db.VarChar(36)
  name              String
  slug              String            @unique
  active            Boolean           @default(true)
  legalName         String?           @map("legal_name") @db.VarChar(160)
  tradeName         String?           @map("trade_name") @db.VarChar(160)
  cnpj              String?           @db.VarChar(18)
  phone             String?           @db.VarChar(32)
  email             String?           @db.VarChar(160)
  zipCode           String?           @map("zip_code") @db.VarChar(16)
  street            String?           @db.VarChar(160)
  number            String?           @db.VarChar(32)
  district          String?           @db.VarChar(80)
  city              String?           @db.VarChar(80)
  stateUf           String?           @map("state_uf") @db.VarChar(2)
  logoUrl           String?           @map("logo_url") @db.VarChar(255)
  currency          String            @default("BRL") @db.VarChar(8)
  timezone          String            @default("America/Sao_Paulo") @db.VarChar(64)
  language          String            @default("pt-BR") @db.VarChar(8)
  revenueTarget     Decimal?          @map("revenue_target") @db.Decimal(14, 2)
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  members           CompanyUser[]
  auditLogs         AuditLog[]
  clients           Client[]
  categories        ProductCategory[]
  products          Product[]
  stockMovements    StockMovement[]
  sales             Sale[]
  suppliers         Supplier[]
  purchases         Purchase[]
  financeCategories FinanceCategory[]
  financeEntries    FinanceEntry[]
  leads             Lead[]
  agendaEvents      AgendaEvent[]

  notificationPreferences NotificationPreference[]
  notifications           Notification[]
  paymentGateways         PaymentGateway[]

  @@map("companies")
}

// Vínculo usuário↔empresa com papel (isolamento multiempresa, ADR-0002).
model CompanyUser {
  id        String   @id @default(uuid()) @db.VarChar(36)
  userId    String   @map("user_id") @db.VarChar(36)
  companyId String   @map("company_id") @db.VarChar(36)
  role      Role     @default(STAFF)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
  @@map("company_users")
}

// Sessões para controle/revogação de tokens de refresh.
model RefreshToken {
  id          String    @id @default(uuid()) @db.VarChar(36)
  userId      String    @map("user_id") @db.VarChar(36)
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdByIp String?   @map("created_by_ip")
  createdAt   DateTime  @default(now()) @map("created_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// Auditoria (seção 36): ator, ação, entidade, contexto empresarial.
model AuditLog {
  id        String   @id @default(uuid()) @db.VarChar(36)
  userId    String?  @map("user_id") @db.VarChar(36)
  companyId String?  @map("company_id") @db.VarChar(36)
  action    String
  entity    String
  entityId  String?  @map("entity_id") @db.VarChar(36)
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([userId])
  @@map("audit_logs")
}

// ===== Modulos empresariais (todos com isolamento por empresa, ADR-0002) =====

enum SaleStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum PurchaseStatus {
  DRAFT
  RECEIVED
  CANCELLED
}

enum StockMovementKind {
  IN
  OUT
  ADJUST
}

enum EntryType {
  INCOME
  EXPENSE
}

enum EntryStatus {
  PENDING
  PAID
  CANCELLED
}

enum LeadStatus {
  NEW
  CONTACTED
  PROPOSAL
  WON
  LOST
}

model Client {
  id             String         @id @default(uuid()) @db.VarChar(36)
  companyId      String         @map("company_id") @db.VarChar(36)
  name           String         @db.VarChar(160)
  email          String?        @db.VarChar(160)
  phone          String?        @db.VarChar(32)
  document       String?        @db.VarChar(32)
  notes          String?        @db.Text
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sales          Sale[]
  financeEntries FinanceEntry[]
  leads          Lead[]
  agendaEvents   AgendaEvent[]

  @@unique([companyId, document])
  @@index([companyId, name])
  @@map("clients")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.VarChar(36)
  userId    String    @map("user_id") @db.VarChar(36)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model ProductCategory {
  id        String    @id @default(uuid()) @db.VarChar(36)
  companyId String    @map("company_id") @db.VarChar(36)
  name      String    @db.VarChar(80)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products  Product[]

  @@unique([companyId, name])
  @@map("product_categories")
}

model Product {
  id            String           @id @default(uuid()) @db.VarChar(36)
  companyId     String           @map("company_id") @db.VarChar(36)
  categoryId    String?          @map("category_id") @db.VarChar(36)
  name          String           @db.VarChar(160)
  sku           String?          @db.VarChar(64)
  unit          String           @default("un") @db.VarChar(16)
  costPrice     Decimal?         @map("cost_price") @db.Decimal(12, 2)
  salePrice     Decimal          @map("sale_price") @db.Decimal(12, 2)
  stockQuantity Decimal          @default(0) @map("stock_quantity") @db.Decimal(12, 3)
  minStock      Decimal          @default(0) @map("min_stock") @db.Decimal(12, 3)
  trackStock    Boolean          @default(true) @map("track_stock")
  description   String?          @db.Text
  active        Boolean          @default(true)
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  company       Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category      ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  movements     StockMovement[]
  saleItems     SaleItem[]
  purchaseItems PurchaseItem[]

  @@unique([companyId, sku])
  @@index([companyId, name])
  @@map("products")
}

// Movimentacao de estoque (entradas/saidas/ajustes). Vendas do modulo
// posterior registrarao saidas com reference cruzada em metadata.
model StockMovement {
  id        String            @id @default(uuid()) @db.VarChar(36)
  companyId String            @map("company_id") @db.VarChar(36)
  productId String            @map("product_id") @db.VarChar(36)
  kind      StockMovementKind
  quantity  Decimal           @db.Decimal(12, 3)
  note      String?           @db.VarChar(255)
  createdBy String?           @map("created_by") @db.VarChar(36)
  createdAt DateTime          @default(now()) @map("created_at")
  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product   Product           @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([companyId, productId, createdAt])
  @@map("stock_movements")
}

// ===== Vendas (modulo 8) =====
model Sale {
  id        String     @id @default(uuid()) @db.VarChar(36)
  companyId String     @map("company_id") @db.VarChar(36)
  clientId  String?    @map("client_id") @db.VarChar(36)
  userId    String?    @map("user_id") @db.VarChar(36)
  status    SaleStatus @default(PENDING)
  total     Decimal    @db.Decimal(14, 2)
  notes     String?    @db.VarChar(500)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client    Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  items     SaleItem[]

  @@index([companyId, status, createdAt])
  @@map("sales")
}

model SaleItem {
  id        String  @id @default(uuid()) @db.VarChar(36)
  saleId    String  @map("sale_id") @db.VarChar(36)
  productId String  @map("product_id") @db.VarChar(36)
  quantity  Decimal @db.Decimal(12, 3)
  unitPrice Decimal @map("unit_price") @db.Decimal(12, 2)
  lineTotal Decimal @map("line_total") @db.Decimal(14, 2)
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@map("sale_items")
}

model Supplier {
  id             String         @id @default(uuid()) @db.VarChar(36)
  companyId      String         @map("company_id") @db.VarChar(36)
  name           String         @db.VarChar(160)
  email          String?        @db.VarChar(160)
  phone          String?        @db.VarChar(40)
  document       String?        @db.VarChar(25)
  notes          String?        @db.VarChar(500)
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchases      Purchase[]
  financeEntries FinanceEntry[]

  @@unique([companyId, name])
  @@index([companyId, active])
  @@map("suppliers")
}

model Purchase {
  id         String         @id @default(uuid()) @db.VarChar(36)
  companyId  String         @map("company_id") @db.VarChar(36)
  supplierId String         @map("supplier_id") @db.VarChar(36)
  userId     String?        @map("user_id") @db.VarChar(36)
  status     PurchaseStatus @default(DRAFT)
  total      Decimal        @db.Decimal(14, 2)
  notes      String?        @db.VarChar(500)
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")
  company    Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier   Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  user       User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  items      PurchaseItem[]

  @@index([companyId, status, createdAt])
  @@map("purchases")
}

model PurchaseItem {
  id         String   @id @default(uuid()) @db.VarChar(36)
  purchaseId String   @map("purchase_id") @db.VarChar(36)
  productId  String   @map("product_id") @db.VarChar(36)
  quantity   Decimal  @db.Decimal(12, 3)
  unitCost   Decimal  @map("unit_cost") @db.Decimal(12, 2)
  lineTotal  Decimal  @map("line_total") @db.Decimal(14, 2)
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([purchaseId])
  @@map("purchase_items")
}

model FinanceCategory {
  id        String         @id @default(uuid()) @db.VarChar(36)
  companyId String         @map("company_id") @db.VarChar(36)
  name      String         @db.VarChar(80)
  type      EntryType
  createdAt DateTime       @default(now()) @map("created_at")
  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  entries   FinanceEntry[]

  @@unique([companyId, name, type])
  @@map("finance_categories")
}

model FinanceEntry {
  id          String           @id @default(uuid()) @db.VarChar(36)
  companyId   String           @map("company_id") @db.VarChar(36)
  categoryId  String?          @map("category_id") @db.VarChar(36)
  clientId    String?          @map("client_id") @db.VarChar(36)
  supplierId  String?          @map("supplier_id") @db.VarChar(36)
  userId      String?          @map("user_id") @db.VarChar(36)
  type        EntryType
  status      EntryStatus      @default(PENDING)
  description String           @db.VarChar(200)
  amount      Decimal          @db.Decimal(14, 2)
  dueDate     DateTime         @map("due_date") @db.Date
  paidAt      DateTime?        @map("paid_at")
  notes       String?          @db.VarChar(500)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category    FinanceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  client      Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  supplier    Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  user        User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, status, dueDate])
  @@map("finance_entries")
}

model Lead {
  id        String     @id @default(uuid()) @db.VarChar(36)
  companyId String     @map("company_id") @db.VarChar(36)
  clientId  String?    @map("client_id") @db.VarChar(36)
  userId    String?    @map("user_id") @db.VarChar(36)
  name      String     @db.VarChar(160)
  email     String?    @db.VarChar(160)
  phone     String?    @db.VarChar(40)
  source    String?    @db.VarChar(60)
  status    LeadStatus @default(NEW)
  value     Decimal    @default(0) @db.Decimal(14, 2)
  notes     String?    @db.VarChar(1000)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client    Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  agendaEvents AgendaEvent[]

  @@index([companyId, status, createdAt])
  @@map("leads")
}

// Modulo Agenda: compromissos da empresa, com vinculo opcional a cliente e lead.
enum AgendaEventType {
  MEETING
  DELIVERY
  FOLLOW_UP
  OTHER
}

enum AgendaRecurrence {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

enum AgendaStatus {
  SCHEDULED
  DONE
  CANCELLED
}

model AgendaEvent {
  id             String           @id @default(uuid()) @db.VarChar(36)
  companyId      String           @map("company_id") @db.VarChar(36)
  userId         String?          @map("user_id") @db.VarChar(36)
  clientId       String?          @map("client_id") @db.VarChar(36)
  leadId         String?          @map("lead_id") @db.VarChar(36)
  title          String           @db.VarChar(160)
  description    String?          @db.VarChar(1000)
  location       String?          @db.VarChar(160)
  type           AgendaEventType  @default(MEETING)
  status         AgendaStatus     @default(SCHEDULED)
  startAt        DateTime         @map("start_at")
  endAt          DateTime?        @map("end_at")
  allDay         Boolean          @default(false) @map("all_day")
  recorrencia    AgendaRecurrence @default(NONE)
  recorrenciaAte DateTime?        @map("recorrencia_ate")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user           User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  client         Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  lead           Lead?            @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([companyId, status, startAt])
  @@index([companyId, startAt])
  @@map("agenda_events")
}

// ===== Configuracoes por empresa e por usuario (Configuracoes / Notificacoes) =====
model NotificationPreference {
  id           String   @id @default(uuid()) @db.VarChar(36)
  userId       String   @map("user_id") @db.VarChar(36)
  companyId    String   @map("company_id") @db.VarChar(36)
  saleAlerts   Boolean  @default(true) @map("sale_alerts")
  lowStock     Boolean  @default(true) @map("low_stock")
  dailyReport  Boolean  @default(false) @map("daily_report")
  overdueBills Boolean  @default(true) @map("overdue_bills")
  newLead      Boolean  @default(true) @map("new_lead")
  emailChannel Boolean  @default(false) @map("email_channel")
  inAppChannel Boolean  @default(true) @map("in_app_channel")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@map("notification_preferences")
}

// Prioridade e exigencia da secao 44. O indice (companyId, userId, readAt)
// atende a listagem; dedupe_key impede que as varreduras periodicas (contas
// vencidas, compromissos proximos) criem o mesmo aviso duas vezes. Em MySQL
// NULL nao viola unique, entao avisos sem chave seguem liberados.
enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
}

model Notification {
  id        String               @id @default(uuid()) @db.VarChar(36)
  userId    String               @map("user_id") @db.VarChar(36)
  companyId String               @map("company_id") @db.VarChar(36)
  kind      String               @db.VarChar(40)
  title     String               @db.VarChar(160)
  body      String?              @db.VarChar(400)
  link      String?              @db.VarChar(200)
  priority  NotificationPriority @default(MEDIUM)
  dedupeKey String?              @unique @map("dedupe_key") @db.VarChar(120)
  readAt    DateTime?            @map("read_at")
  createdAt DateTime             @default(now()) @map("created_at")
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, userId, readAt])
  @@map("notifications")
}

// ===== CMS da landing page publica (conteudo global da plataforma) =====
// Linha única de id "default"; os blocos Json guardam cores, whatsapp, SEO e
// manutenção. Sem @default em Json: MySQL exige expressão, não literal.
model LandingConfig {
  id          String   @id @db.VarChar(36)
  headline    String?  @db.VarChar(200)
  subheadline String?  @db.VarChar(400)
  colors      Json
  whatsapp    Json
  seo         Json
  maintenance Json
  // Blocos da vitrine que nao fazem sentido como linha avulsa: o heroi (CTAs,
  // imagem de fundo, overlay e desfoque) e os canais de contato e redes.
  hero        Json?
  social      Json?
  contact     Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("landing_configs")
}

enum LandingItemKind {
  BANNER
  FEATURE
  TESTIMONIAL
  METRIC
  FAQ
}

model LandingItem {
  id        String          @id @default(uuid()) @db.VarChar(36)
  kind      LandingItemKind
  title     String          @db.VarChar(200)
  body      String?         @db.Text
  imageUrl  String?         @map("image_url") @db.VarChar(255)
  link      String?         @db.VarChar(200)
  author    String?         @db.VarChar(120)
  role      String?         @db.VarChar(120)
  // Extras por tipo: estrelas e empresa no depoimento, valor e formato da
  // metrica, icone e rota da capacidade. Fica fora das colunas fixas porque
  // cada tipo tem o seu proprio desenho.
  meta      Json?
  order     Int             @default(0) @map("sort_order")
  active    Boolean         @default(true)
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  @@index([kind, active, order])
  @@map("landing_items")
}

enum LegalKind {
  TERMS
  PRIVACY
  LGPD
}

model LegalDocument {
  id        String    @id @default(uuid()) @db.VarChar(36)
  kind      LegalKind @unique
  title     String    @db.VarChar(160)
  content   String?   @db.Text
  published Boolean   @default(false)
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("legal_documents")
}

// ===== Operacoes: modelos de e-mail transacional e rotinas agendadas =====
model EmailTemplate {
  id        String   @id @default(uuid()) @db.VarChar(36)
  slug      String   @unique @db.VarChar(60)
  name      String   @db.VarChar(120)
  subject   String   @db.VarChar(200)
  body      String?  @db.Text
  variables Json
  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("email_templates")
}

model CronJob {
  id          String    @id @default(uuid()) @db.VarChar(36)
  slug        String    @unique @db.VarChar(60)
  name        String    @db.VarChar(120)
  description String?   @db.VarChar(400)
  schedule    String    @db.VarChar(60)
  enabled     Boolean   @default(true)
  lastRunAt   DateTime? @map("last_run_at")
  lastStatus  String?   @map("last_status") @db.VarChar(20)
  lastMessage String?   @map("last_message") @db.VarChar(400)
  durationMs  Int?      @map("duration_ms")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("cron_jobs")
}

// ===== Integradores de pagamento (credenciais por empresa e ambiente) =====
enum GatewayProvider {
  MERCADO_PAGO
  EFI
  STRIPE
}

enum GatewayEnvironment {
  SANDBOX
  PRODUCTION
}

model PaymentGateway {
  id               String             @id @default(uuid()) @db.VarChar(36)
  companyId        String             @map("company_id") @db.VarChar(36)
  provider         GatewayProvider
  environment      GatewayEnvironment @default(SANDBOX)
  displayName      String?            @map("display_name") @db.VarChar(120)
  publicKey        String?            @map("public_key") @db.VarChar(255)
  credentialCipher String?            @map("credential_cipher") @db.Text
  webhookCipher    String?            @map("webhook_cipher") @db.Text
  active           Boolean            @default(false)
  lastCheckAt      DateTime?          @map("last_check_at")
  lastCheckStatus  String?            @map("last_check_status") @db.VarChar(20)
  lastCheckMessage String?            @map("last_check_message") @db.VarChar(400)
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  company          Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, provider, environment])
  @@index([companyId])
  @@map("payment_gateways")
}
