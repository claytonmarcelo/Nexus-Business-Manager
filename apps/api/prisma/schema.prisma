// Nexus Business Manager — schema novo (reconstrução do zero).
// Persistência única via Prisma (ADR-0001). MySQL localhost:3306 / nexusbusinessmanager.
// IDs são UUID (36 chars): tipados como VarChar(36) para manter índices compostos
// dentro do limite de chave do InnoDB com utf8mb4.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  STAFF
}

model User {
  id           String         @id @default(uuid()) @db.VarChar(36)
  email        String         @unique
  name         String
  passwordHash String         @map("password_hash")
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  memberships  CompanyUser[]
  sessions     RefreshToken[]
  auditLogs    AuditLog[]

  @@map("users")
}

model Company {
  id        String        @id @default(uuid()) @db.VarChar(36)
  name      String
  slug      String        @unique
  active    Boolean       @default(true)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  members     CompanyUser[]
  auditLogs   AuditLog[]
  clients     Client[]

  @@map("companies")
}

// Vínculo usuário↔empresa com papel (isolamento multiempresa, ADR-0002).
model CompanyUser {
  id        String   @id @default(uuid()) @db.VarChar(36)
  userId    String   @map("user_id") @db.VarChar(36)
  companyId String   @map("company_id") @db.VarChar(36)
  role      Role     @default(STAFF)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
  @@map("company_users")
}

// Sessões para controle/revogação de tokens de refresh.
model RefreshToken {
  id          String    @id @default(uuid()) @db.VarChar(36)
  userId      String    @map("user_id") @db.VarChar(36)
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdByIp String?   @map("created_by_ip")
  createdAt   DateTime  @default(now()) @map("created_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// Auditoria (seção 36): ator, ação, entidade, contexto empresarial.
model AuditLog {
  id        String   @id @default(uuid()) @db.VarChar(36)
  userId    String?  @map("user_id") @db.VarChar(36)
  companyId String?  @map("company_id") @db.VarChar(36)
  action    String
  entity    String
  entityId  String?  @map("entity_id") @db.VarChar(36)
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([userId])
  @@map("audit_logs")
}

// ===== Modulos empresariais (todos com isolamento por empresa, ADR-0002) =====

enum SaleStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum PurchaseStatus {
  DRAFT
  RECEIVED
  CANCELLED
}

enum StockMovementKind {
  IN
  OUT
  ADJUST
}

enum EntryType {
  INCOME
  EXPENSE
}

enum EntryStatus {
  PENDING
  PAID
  CANCELLED
}

enum LeadStatus {
  NEW
  CONTACTED
  PROPOSAL
  WON
  LOST
}

model Client {
  id        String   @id @default(uuid()) @db.VarChar(36)
  companyId String   @map("company_id") @db.VarChar(36)
  name      String   @db.VarChar(160)
  email     String?  @db.VarChar(160)
  phone     String?  @db.VarChar(32)
  document  String?  @db.VarChar(32)
  notes     String?  @db.Text
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, document])
  @@index([companyId, name])
  @@map("clients")
}
