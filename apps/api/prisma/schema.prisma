// ===== Configuracoes por empresa e por usuario (Configuracoes / Notificacoes) =====
model NotificationPreference {
  id           String   @id @default(uuid()) @db.VarChar(36)
  userId       String   @map("user_id") @db.VarChar(36)
  companyId    String   @map("company_id") @db.VarChar(36)
  saleAlerts   Boolean  @default(true) @map("sale_alerts")
  lowStock     Boolean  @default(true) @map("low_stock")
  dailyReport  Boolean  @default(false) @map("daily_report")
  overdueBills Boolean  @default(true) @map("overdue_bills")
  newLead      Boolean  @default(true) @map("new_lead")
  emailChannel Boolean  @default(false) @map("email_channel")
  inAppChannel Boolean  @default(true) @map("in_app_channel")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@map("notification_preferences")
}

// Prioridade e exigencia da secao 44. O indice (companyId, userId, readAt)
// atende a listagem; dedupe_key impede que as varreduras periodicas (contas
// vencidas, compromissos proximos) criem o mesmo aviso duas vezes. Em MySQL
// NULL nao viola unique, entao avisos sem chave seguem liberados.
enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
}

model Notification {
  id        String               @id @default(uuid()) @db.VarChar(36)
  userId    String               @map("user_id") @db.VarChar(36)
  companyId String               @map("company_id") @db.VarChar(36)
  kind      String               @db.VarChar(40)
  title     String               @db.VarChar(160)
  body      String?              @db.VarChar(400)
  link      String?              @db.VarChar(200)
  priority  NotificationPriority @default(MEDIUM)
  dedupeKey String?              @unique @map("dedupe_key") @db.VarChar(120)
  readAt    DateTime?            @map("read_at")
  createdAt DateTime             @default(now()) @map("created_at")
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, userId, readAt])
  @@map("notifications")
}

// ===== CMS da landing page publica (conteudo global da plataforma) =====
// Linha única de id "default"; os blocos Json guardam cores, whatsapp, SEO e
// manutenção. Sem @default em Json: MySQL exige expressão, não literal.
model LandingConfig {
  id          String   @id @db.VarChar(36)
  headline    String?  @db.VarChar(200)
  subheadline String?  @db.VarChar(400)
  colors      Json
  whatsapp    Json
  seo         Json
  maintenance Json
  // Blocos da vitrine que nao fazem sentido como linha avulsa: o heroi (CTAs,
  // imagem de fundo, overlay e desfoque) e os canais de contato e redes.
  hero        Json?
  social      Json?
  contact     Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("landing_configs")
}

enum LandingItemKind {
  BANNER
  FEATURE
  TESTIMONIAL
  METRIC
  FAQ
}

model LandingItem {
  id        String          @id @default(uuid()) @db.VarChar(36)
  kind      LandingItemKind
  title     String          @db.VarChar(200)
  body      String?         @db.Text
  imageUrl  String?         @map("image_url") @db.VarChar(255)
  link      String?         @db.VarChar(200)
  author    String?         @db.VarChar(120)
  role      String?         @db.VarChar(120)
  // Extras por tipo: estrelas e empresa no depoimento, valor e formato da
  // metrica, icone e rota da capacidade. Fica fora das colunas fixas porque
  // cada tipo tem o seu proprio desenho.
  meta      Json?
  order     Int             @default(0) @map("sort_order")
  active    Boolean         @default(true)
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  @@index([kind, active, order])
  @@map("landing_items")
}

enum LegalKind {
  TERMS
  PRIVACY
  LGPD
}

model LegalDocument {
  id        String    @id @default(uuid()) @db.VarChar(36)
  kind      LegalKind @unique
  title     String    @db.VarChar(160)
  content   String?   @db.Text
  published Boolean   @default(false)
  // F7 (LGPD): qual texto a pessoa aceitou. O número sobe de um a cada mudança de
  // conteúdo gravada pelo editor da plataforma (`cms.service.ts`), e é ele que a
  // linha de aceite guarda. Sem esta coluna, "ele aceitou os termos" seria uma
  // afirmação sobre um texto que já não existe.
  version   Int       @default(1)
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("legal_documents")
}

// F7 (LGPD, item 1): registro de aceite dos textos legais.
//
// Uma linha por aceite, e o histórico não se sobrescreve: quando a versão muda e a
// pessoa aceita de novo, a linha antiga continua contando o que estava em vigor
// naquela data. É isto que responde a um pedido de "mostre o que este usuário
// aceitou" — a resposta é a data, o endereço de onde ele aceitou e a versão do
// documento, e nada mais.
//
// `kind` e `version` são cópia do momento do aceite, e não uma junção viva com
// `legal_documents`, de propósito: o documento pode ser reescrito amanhã, e a
// prova do que foi aceito ontem não pode mudar com ele. A relação é só com o
// usuário, e cai junto da conta.
model ConsentRecord {
  id         String    @id @default(uuid()) @db.VarChar(36)
  userId     String    @map("user_id") @db.VarChar(36)
  kind       LegalKind
  version    Int
  ip         String?   @db.VarChar(64)
  acceptedAt DateTime  @default(now()) @map("accepted_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, version])
  @@index([kind, version])
  @@map("consent_records")
}

// ===== Operacoes: modelos de e-mail transacional e rotinas agendadas =====
model EmailTemplate {
  id        String   @id @default(uuid()) @db.VarChar(36)
  slug      String   @unique @db.VarChar(60)
  name      String   @db.VarChar(120)
  subject   String   @db.VarChar(200)
  body      String?  @db.Text
  variables Json
  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("email_templates")
}

model CronJob {
  id          String    @id @default(uuid()) @db.VarChar(36)
  slug        String    @unique @db.VarChar(60)
  name        String    @db.VarChar(120)
  description String?   @db.VarChar(400)
  schedule    String    @db.VarChar(60)
  enabled     Boolean   @default(true)
  lastRunAt   DateTime? @map("last_run_at")
  lastStatus  String?   @map("last_status") @db.VarChar(20)
  lastMessage String?   @map("last_message") @db.VarChar(400)
  durationMs  Int?      @map("duration_ms")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("cron_jobs")
}

// ===== Integradores de pagamento (credenciais por empresa e ambiente) =====
enum GatewayProvider {
  // Parte 2 (Cobranças): o MANUAL é o gateway da própria empresa — PIX na chave
  // cadastrada, boleto ou transferência combinados no balcão, dinheiro ou cartão
  // na maquininha. Ele existe porque a cobrança acontece antes de qualquer
  // integração: quem registra o recebimento é uma pessoa, nunca um webhook.
  MANUAL
  MERCADO_PAGO
  EFI
  STRIPE
}

enum GatewayEnvironment {
  SANDBOX
  PRODUCTION
}

model PaymentGateway {
  id               String             @id @default(uuid()) @db.VarChar(36)
  companyId        String             @map("company_id") @db.VarChar(36)
  provider         GatewayProvider
  environment      GatewayEnvironment @default(SANDBOX)
  displayName      String?            @map("display_name") @db.VarChar(120)
  publicKey        String?            @map("public_key") @db.VarChar(255)
  credentialCipher String?            @map("credential_cipher") @db.Text
  webhookCipher    String?            @map("webhook_cipher") @db.Text
  active           Boolean            @default(false)
  // F3.2 Parte 2: a configuração do gateway MANUAL — tipo e valor da chave PIX,
  // beneficiário, instruções ao cliente e dias de vencimento padrão. É JSON de
  // exibição, e não credencial: as colunas cifradas acima continuam vazias para
  // todo provedor deste projeto, inclusive para o MANUAL.
  chargeSettings   Json?              @map("charge_settings")
  lastCheckAt      DateTime?          @map("last_check_at")
  lastCheckStatus  String?            @map("last_check_status") @db.VarChar(20)
  lastCheckMessage String?            @map("last_check_message") @db.VarChar(400)
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  company          Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, provider, environment])
  @@index([companyId])
  @@map("payment_gateways")
}

// ===== Ordens de serviço (F3.2 Parte 1) =====
//
// A ordem de serviço é o documento do serviço prestado: o cliente chega com um
// equipamento com defeito, a empresa abre a ordem, atribui quem vai atender,
// anota o que descobriu, cobra mão de obra e peças, e só então baixa o estoque.
// Ela resolve o que a venda não resolve: na venda a mercadoria sai no momento
// em que a nota é confirmada, mas um conserto vive dias — a peça pode faltar, o
// cliente pode sumir, e o serviço pode ser cobrado sem que nada tenha saído do
// depósito. Por isso o estoque da OS baixa na CONCLUSÃO, nunca na abertura, e
// por isso existe um histórico: quem lê a OS seis meses depois precisa saber quem
// mudou o quê, e quando.
//
// O número é sequencial POR EMPRESA (a OS 0001 da padaria não é a OS 0001 da
// assistência técnica), e o UNIQUE abaixo é a única coisa que impede duas OS
// simultâneas de nascerem com o mesmo número — o serviço tenta, e em caso de
// conflito recomeça a conta numa transação nova.

enum ServiceOrderStatus {
  OPEN
  IN_PROGRESS
  WAITING
  COMPLETED
  CANCELLED
}

enum ServiceOrderPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ServiceOrderItemKind {
  SERVICE
  PART
}

model ServiceOrder {
  id             String                @id @default(uuid()) @db.VarChar(36)
  companyId      String                @map("company_id") @db.VarChar(36)
  // Sequencial por empresa. Não é o id: o id serve para a máquina, o número
  // serve para o balcão e para a conversa com o cliente.
  number         Int
  clientId       String                @map("client_id") @db.VarChar(36)
  assignedUserId String?               @map("assigned_user_id") @db.VarChar(36)
  status         ServiceOrderStatus    @default(OPEN)
  priority       ServiceOrderPriority  @default(NORMAL)
  title          String                @db.VarChar(160)
  description    String?               @db.Text
  diagnosis      String?               @db.Text
  scheduledAt    DateTime?             @map("scheduled_at")
  startedAt      DateTime?             @map("started_at")
  completedAt    DateTime?             @map("completed_at")
  // O desconto é gravado junto da OS, mas o total nunca vem da tela: ele é a
  // soma das linhas em centavo menos o desconto, calculada no servidor (Fase 3d
  // — dinheiro anda em Decimal, não em vírgula flutuante).
  discount       Decimal               @default(0) @db.Decimal(14, 2)
  total          Decimal               @db.Decimal(14, 2)
  notes          String?               @db.VarChar(500)
  createdBy      String?               @map("created_by") @db.VarChar(36)
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  company        Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // Restrict nos dois lados do cadastro: cliente com ordem de serviço não se
  // apaga, e peça que já saiu numa OS concluída também não. Histórico é a
  // memória da empresa — não se apaga memória para liberar um formulário.
  client         Client                @relation(fields: [clientId], references: [id], onDelete: Restrict)
  assignedUser   User?                 @relation("ServiceOrderAssigned", fields: [assignedUserId], references: [id], onDelete: SetNull)
  creator        User?                 @relation("ServiceOrderCreated", fields: [createdBy], references: [id], onDelete: SetNull)
  items          ServiceOrderItem[]
  history        ServiceOrderHistory[]
  charges        Charge[]

  @@unique([companyId, number])
  @@index([companyId, status, createdAt])
  @@index([companyId, assignedUserId])
  @@map("service_orders")
}

// Linha da OS: mão de obra (SERVICE, descrita em texto) ou peça (PART, apontada
// para o produto). As duas coexistem no mesmo documento porque é assim que o
// serviço é cobrado no balcão.
model ServiceOrderItem {
  id             String               @id @default(uuid()) @db.VarChar(36)
  serviceOrderId String               @map("service_order_id") @db.VarChar(36)
  // A linha digitada primeiro é a linha que aparece primeiro no documento e no
  // impresso. Sem esta coluna o banco devolveria as linhas pela ordem do uuid.
  lineNumber     Int                  @map("line_number")
  kind           ServiceOrderItemKind
  productId      String?              @map("product_id") @db.VarChar(36)
  description    String?              @db.VarChar(200)
  quantity       Decimal              @db.Decimal(12, 3)
  unitPrice      Decimal              @map("unit_price") @db.Decimal(12, 2)
  lineTotal      Decimal              @map("line_total") @db.Decimal(14, 2)
  serviceOrder   ServiceOrder         @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  product        Product?             @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([serviceOrderId])
  @@index([productId])
  @@map("service_order_items")
}

// Trilha imutável de mudança de status. Não se edita nem se apaga linha aqui:
// ela é a prova de quem tomou cada decisão, incluída a de estornar uma OS
// concluída — que só ADMIN/OWNER fazem.
model ServiceOrderHistory {
  id             String              @id @default(uuid()) @db.VarChar(36)
  serviceOrderId String              @map("service_order_id") @db.VarChar(36)
  fromStatus     ServiceOrderStatus? @map("from_status")
  toStatus       ServiceOrderStatus  @map("to_status")
  userId         String?             @map("user_id") @db.VarChar(36)
  note           String?             @db.VarChar(500)
  createdAt      DateTime            @default(now()) @map("created_at")
  serviceOrder   ServiceOrder        @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  user           User?               @relation("ServiceOrderHistory", fields: [userId], references: [id], onDelete: SetNull)

  @@index([serviceOrderId, createdAt])
  @@map("service_order_histories")
}

// ===== Cobranças (F3.2 Parte 2) =====
//
// A cobrança é o papel que a empresa estende ao cliente: "você deve X até tal
// dia, e aqui está como pagar". Ela nasce da venda, da ordem de serviço ou
// sozinha, e vive no mundo manual enquanto não há integração — PIX na chave
// cadastrada, boleto combinado no balcão, transferência, dinheiro ou cartão na
// maquininha. O que faz dela um documento, e não uma linha do financeiro, é o
// vínculo dos dois lados: ela aponta para o papel que originou a dívida e, ao
// ser paga, escreve uma única receita no caixa.
//
// A numeração é sequencial POR EMPRESA, igual à da OS: UNIQUE(company_id,
// number) transforma a corrida entre duas requisições em chave duplicada, e o
// serviço refaz a conta. O caixa tem a prova estrutural do mesmo jeito:
// `finance_entry_id` é UNIQUE, então duas pessoas pagando a mesma cobrança ao
// mesmo tempo não produzem dois lançamentos — a segunda morre antes de escrever.
//
// "Vencida" não é coluna: é a leitura de `due_date` contra o calendário da
// empresa (lib/time.ts). Uma coluna envelheceria sozinha a cada meia-noite e
// mentiria para quem consulta na véspera; aqui o estado vence ou não vence no
// instante em que é lido.

enum ChargeMethod {
  PIX
  BOLETO
  TRANSFERENCIA
  DINHEIRO
  CARTAO
  OUTRO
}

enum ChargeStatus {
  PENDING
  PAID
  CANCELLED
}

model Charge {
  id             String          @id @default(uuid()) @db.VarChar(36)
  companyId      String          @map("company_id") @db.VarChar(36)
  number         Int
  // Os três vínculos são opcionais, mas a camada de serviço exige pelo menos um:
  // cobrança sem destinatário não é cobrança, é desejo. Quando a venda ou a OS
  // existe, o cliente vem dela — o que a tela aponta é o que vale.
  clientId       String?         @map("client_id") @db.VarChar(36)
  saleId         String?         @map("sale_id") @db.VarChar(36)
  serviceOrderId String?         @map("service_order_id") @db.VarChar(36)
  title          String          @db.VarChar(160)
  amount         Decimal         @db.Decimal(14, 2)
  dueDate        DateTime        @map("due_date") @db.Date
  method         ChargeMethod
  // Toda cobrança deste projeto nasce do gateway MANUAL. A coluna existe para o
  // dia em que um provedor de mercado entrar: o vínculo com a transação externa
  // será dele, e o histórico das cobranças manuais continuará dizendo a verdade.
  provider       GatewayProvider @default(MANUAL)
  pixKeyType     String?         @map("pix_key_type") @db.VarChar(16)
  pixKey         String?         @map("pix_key") @db.VarChar(255)
  instructions   String?         @db.VarChar(500)
  notes          String?         @db.VarChar(500)
  status         ChargeStatus    @default(PENDING)
  paidAt         DateTime?       @map("paid_at")
  paidMethod     ChargeMethod?   @map("paid_method")
  paidBy         String?         @map("paid_by") @db.VarChar(36)
  paymentNote    String?         @map("payment_note") @db.VarChar(500)
  cancelledAt    DateTime?       @map("cancelled_at")
  cancelReason   String?         @map("cancel_reason") @db.VarChar(500)
  cancelledBy    String?         @map("cancelled_by") @db.VarChar(36)
  // O único laço com o caixa, e ele é UNIQUE por construção: uma cobrança gera
  // no máximo um lançamento, e a corrida de pagamentos morre aqui.
  financeEntryId String?         @unique @map("finance_entry_id") @db.VarChar(36)
  createdBy      String?         @map("created_by") @db.VarChar(36)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // RESTRICT nos documentos: cobrança pendente é dívida escrita, e o cliente, a
  // venda ou a OS por trás dela não somem por trás dela.
  client         Client?         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  sale           Sale?           @relation(fields: [saleId], references: [id], onDelete: Restrict)
  serviceOrder   ServiceOrder?   @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict)
  financeEntry   FinanceEntry?   @relation(fields: [financeEntryId], references: [id], onDelete: SetNull)
  creator        User?           @relation("ChargeCreated", fields: [createdBy], references: [id], onDelete: SetNull)
  payer          User?           @relation("ChargePaid", fields: [paidBy], references: [id], onDelete: SetNull)
  canceller      User?           @relation("ChargeCancelled", fields: [cancelledBy], references: [id], onDelete: SetNull)

  @@unique([companyId, number])
  @@index([companyId, status, dueDate])
  @@index([companyId, clientId])
  @@index([saleId])
  @@index([serviceOrderId])
  @@map("charges")
}
