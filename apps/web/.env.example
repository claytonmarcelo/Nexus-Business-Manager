# URL base da API. Em desenvolvimento o Vite faz proxy de /api para a API (ver vite.config.ts),
# e na pilha Docker o nginx do painel faz o mesmo proxy — nos dois casos o valor fica /api.
VITE_API_URL=/api

# Publicado em host estático (Vercel e afins) não existe proxy na frente: aponte para a API real.
#   VITE_API_URL=https://api.exemplo.test
# O painel completa o /api que falta (apps/web/src/lib/apiBase.ts), mas do outro lado a API
# precisa conhecer este endereço em CORS_ORIGIN — sem isso o navegador bloqueia a chamada.
