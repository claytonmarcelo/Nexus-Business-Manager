# syntax=docker/dockerfile:1
#
# F6 (T5.1) — o painel como o que ele é: arquivos estáticos. A etapa de compilação roda o
# mesmo `npm run build --workspace @nexus/web` da casa (tsc -b + vite build, os 37 pedaços
# do D8/T4.8); a etapa que serve não tem Node, não tem npm e não tem fonte — é nginx com a
# pasta `dist` dentro. Uma imagem de painel que carrega o compilador consigo é superfície de
# ataque com nome bonito.

# ---------------------------------------------------------------- 1) build do painel
FROM node:20-bookworm-slim AS compilacao
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
RUN npm ci
COPY apps/web ./apps/web
RUN npm run build --workspace @nexus/web

# ---------------------------------------------------------------- 2) nginx servindo o dist
FROM nginx:1.27-alpine AS execucao
# A conf é um arquivo só e ela mora em deploy/nginx-painel.conf: proxy de /api, fallback de
# SPA e o max-body amarrado ao BODY_LIMIT_BYTES da API.
COPY deploy/nginx-painel.conf /etc/nginx/conf.d/default.conf
COPY --from=compilacao /app/apps/web/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=15s --timeout=4s --start-period=10s --retries=3 \
  CMD ["wget","-q","-O","/dev/null","http://127.0.0.1/"]
