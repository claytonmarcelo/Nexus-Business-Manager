NODE_ENV=development
PORT=3333
DATABASE_URL="mysql://root:@localhost:3306/nexus_business_manager"
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=nexus_business_manager
JWT_SECRET=
JWT_EXPIRES_IN=1d
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
UPLOADS_DIR=uploads
MAX_UPLOAD_SIZE_MB=5
LOG_LEVEL=debug
BACKUP_PATH=./database/backups

# Nexus AI Assistant
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
AI_TIMEOUT_MS=20000
AI_ENABLED=true
