{
  "name": "nexus-business-manager-api",
  "version": "1.0.0",
  "description": "Nexus Business Manager - API REST",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "vitest run",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx src/shared/database/migrate.ts",
    "seed": "tsx src/shared/database/seed.ts",
    "demo-seed": "tsx src/shared/database/demo-seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/static": "^7.0.4",
    "@prisma/adapter-mariadb": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "fastify": "^4.28.1",
    "mariadb": "^3.5.2",
    "mysql2": "^3.11.0",
    "pdfkit": "^0.18.0",
    "prisma": "^7.8.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.10",
    "@types/pdfkit": "^0.17.6",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^4.1.8"
  }
}
